<view class="page">
  <!-- 顶部用户卡片：背景图 + 渐变蒙层 -->
  <view class="profile">
    <image class="profile__bg" src="/images/hero.jpg" mode="aspectFill"></image>
    <view class="profile__mask"></view>

    <!-- 已登录 -->
    <view class="profile__body" wx:if="{{isLoggedIn}}">
      <view class="profile__avatar">{{avatarText}}</view>
      <view class="profile__info">
        <view class="profile__name">{{user.nickName}}</view>
        <view class="profile__meta">{{user.college}} · {{user.studentId}}</view>
      </view>
      <view class="profile__badge">已登录</view>
    </view>

    <!-- 未登录 -->
    <view class="profile__body" wx:else bindtap="onLogin">
      <view class="profile__avatar profile__avatar--guest">?</view>
      <view class="profile__info">
        <view class="profile__name">未登录</view>
        <view class="profile__meta">点击登录，同步你的预约记录</view>
      </view>
      <view class="profile__login">登录</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats">
    <view class="stats__item">
      <view class="stats__num">{{stats.total}}</view>
      <view class="stats__label">累计预约</view>
    </view>
    <view class="stats__line"></view>
    <view class="stats__item">
      <view class="stats__num">{{hours}}</view>
      <view class="stats__label">自习时长(h)</view>
    </view>
    <view class="stats__line"></view>
    <view class="stats__item">
      <view class="stats__num">{{stats.active}}</view>
      <view class="stats__label">进行中</view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="card list">
    <view
      wx:for="{{menus}}"
      wx:key="key"
      class="list__item"
      data-key="{{item.key}}"
      bindtap="onMenu"
    >
      <text class="list__name">{{item.name}}</text>
      <text class="list__arrow">›</text>
    </view>
  </view>

  <!-- 账号操作 -->
  <view class="card list">
    <view class="list__item" wx:if="{{isLoggedIn}}" bindtap="onLogout">
      <text class="list__name list__name--danger">退出登录</text>
      <text class="list__arrow">›</text>
    </view>
    <view class="list__item" wx:else bindtap="onLogin">
      <text class="list__name list__name--primary">立即登录</text>
      <text class="list__arrow">›</text>
    </view>

    <view class="list__item" bindtap="onReset">
      <text class="list__name list__name--danger">重置演示数据</text>
      <text class="list__arrow">›</text>
    </view>
  </view>

  <view class="version">图书馆预约系统 · v1.0.5</view>
</view>
